<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography Styles -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>

    <!-- Button Primary -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.btn-primary:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
    <Style Selector="Button.btn-primary:pressed">
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryDark}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
    </Style>

    <!-- Button Secondary -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
    </Style>

    <!-- Button Danger -->
    <Style Selector="Button.btn-danger">
        <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- TextBox Styling -->
    <Style Selector="TextBox">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.22" />
                <ThicknessTransition Property="BorderThickness" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Login-style large TextBox (Module 1) -->
    <Style Selector="TextBox.input-login">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource BrushGlassStrong}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassBorder}" />
    </Style>
    <!-- Ô nhập báo lỗi bằng viền đỏ (thêm class "invalid") -->
    <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
    </Style>

    <!-- ===== Liquid glass: dùng lại cho mọi màn hình ===== -->
    <Style Selector="Border.glass-card">
        <Setter Property="Background" Value="{DynamicResource BrushGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BoxShadow" Value="0 16 40 0 #1F000000" />
    </Style>
    <Style Selector="Border.glass-bar">
        <Setter Property="Background" Value="{DynamicResource BrushGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.glass-side">
        <Setter Property="Background" Value="{DynamicResource BrushGlass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushGlassBorder}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- CheckBox Styling -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPrimary}" />
    </Style>

    <!-- Icon-only ghost button (dùng cho nút con mắt hiện/ẩn mật khẩu) -->
    <Style Selector="Button.btn-icon-ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    </Style>
    <Style Selector="Button.btn-icon-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
    </Style>

    <!-- Fade cho text lỗi (Module 1 - error feedback) -->
    <Style Selector="TextBlock.error-fade">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.35" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.error-fade.visible">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Dòng trạng thái (StatusMessage) — dùng Classes="status" Classes.error="{Binding IsStatusError}"
         thay vì gán thẳng Foreground="{Binding IsStatusError, Converter=...}" (converter trả bool/object,
         không gán thẳng được vào IBrush). -->
    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}" />
    </Style>
    <Style Selector="TextBlock.status.error">
        <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    </Style>

    <!-- ===== Modern DataGrid & Table Styling ===== -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushTableDivider}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="DataGridRow:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushRowHover}" />
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource BrushPrimaryLight}" />
    </Style>

    <!-- Card & Panel Elevation -->
    <Style Selector="Border.card-elevated">
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #0A000000, 0 1 3 0 #04000000" />
    </Style>

    <Style Selector="Border.table-container">
        <Setter Property="Background" Value="{DynamicResource BrushBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 4 20 0 #0A000000" />
    </Style>

    <!-- Modern Apple-Style Segmented Control Bar -->
    <Style Selector="ListBox.segmented-bar">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Height" Value="38" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented-bar ListBoxItem">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="Foreground" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented-bar ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource BrushSegmentedSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushSegmentedSelectedFg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.segmented-bar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrushSegmentedSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource BrushSegmentedSelectedFg}" />
    </Style>

    <!-- Circular / Rounded Row Action Buttons with Smooth Hover Scale -->
    <Style Selector="Button.row-action">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.row-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        <Setter Property="RenderTransform" Value="scale(1.1)" />
    </Style>
    <Style Selector="Button.row-action.view:pointerover">
        <Setter Property="Background" Value="#DBEAFE" />
    </Style>
    <Style Selector="Button.row-action.copy:pointerover">
        <Setter Property="Background" Value="#E0E7FF" />
    </Style>
    <Style Selector="Button.row-action.pdf:pointerover">
        <Setter Property="Background" Value="#FEE2E2" />
    </Style>
    <Style Selector="Button.row-action.edit:pointerover">
        <Setter Property="Background" Value="#DCFCE7" />
    </Style>
    <Style Selector="Button.row-action.delete:pointerover">
        <Setter Property="Background" Value="#FEE2E2" />
    </Style>

    <!-- Capsule Progress Bar -->
    <Style Selector="ProgressBar">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
    </Style>

</Styles>
