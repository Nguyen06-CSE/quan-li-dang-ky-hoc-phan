<!-- src/QuanLyDKHP.App/Views/MonHocView.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:dtos="using:QuanLyDKHP.Core.Dtos"
             x:Class="QuanLyDKHP.App.Views.MonHocView"
             x:DataType="vm:MonHocViewModel">

    <!-- ✅ ĐỔI MỚI: RowDefinitions = Auto (Header), Auto (Toolbar), Auto (ProgressBar), * (DataGrid cuộn vô tận) -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        
        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Môn học" Classes="h1" />
        </StackPanel>

        <!-- Status Message Banner -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Classes="status" Classes.error="{Binding IsStatusError}" />
        </Border>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="280,200,*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding TuKhoa, Mode=TwoWay}" 
                     PlaceholderText="Tìm theo Mã môn hoặc Tên môn..." Margin="0,0,8,0" />

            <!-- ✅ ĐỔI MỚI: ComboBox giờ bind SelectedIndex (TwoWay) với ViewModel → sort thực sự hoạt động -->
            <ComboBox Grid.Column="1" 
                      SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}" 
                      HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <ComboBoxItem Content="Tên môn A → Z" />
                <ComboBoxItem Content="Tên môn Z → A" />
                <ComboBoxItem Content="Mã môn" />
            </ComboBox>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ExportExcelCommand}" Content="Xuất Excel" Classes="btn-secondary" />
                <Button Command="{Binding ThemCommand}" Content="+ Thêm môn học" Classes="btn-primary" IsVisible="{Binding CanThemSuaXoa}" />
            </StackPanel>
        </Grid>

        <!-- ✅ THÊM MỚI: Thanh loading chạy vô tận khi đang lọc dữ liệu -->
        <ProgressBar Grid.Row="2" 
                     Height="2" 
                     HorizontalAlignment="Stretch" 
                     IsIndeterminate="True" 
                     IsVisible="{Binding IsLoading}" 
                     Margin="0,0,0,8"/>

        <!-- 3. DataGrid (nằm ở Row * → Avalonia tự động bật UI Virtualization / Infinite Scrolling) -->
        <DataGrid Grid.Row="3" 
                  x:Name="MonHocDataGrid"
                  ItemsSource="{Binding DanhSach}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="All" 
                  BorderThickness="1" 
                  BorderBrush="{DynamicResource BrushBorder}" 
                  CornerRadius="6"
                  SelectionMode="Single">
            
            <!-- ContextMenu hiển thị khi click chuột trái vào row (giữ nguyên từ trước) -->
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="✏️ Sửa" 
                                      Command="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).SuaCommand}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).CanThemSuaXoa}" />
                            <MenuItem Header="🗑️ Xóa" 
                                      Command="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).XoaCommand}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).CanThemSuaXoa}" />
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã môn" Binding="{Binding MaMon}" Width="140" />
                <DataGridTextColumn Header="Tên môn" Binding="{Binding TenMon}" Width="*" />
                <DataGridTextColumn Header="Số TC LT" Binding="{Binding SoTinChiLT}" Width="110" />
                <DataGridTextColumn Header="Số TC TH" Binding="{Binding SoTinChiTH}" Width="110" />
                <DataGridTextColumn Header="Tổng TC" Binding="{Binding TongTinChi}" Width="110" />
                <DataGridTextColumn Header="Bậc ĐT" Binding="{Binding BacDaoTao}" Width="130" />
                <DataGridTextColumn Header="Số LHP đang mở" Binding="{Binding SoLhpDangMo}" Width="150" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>