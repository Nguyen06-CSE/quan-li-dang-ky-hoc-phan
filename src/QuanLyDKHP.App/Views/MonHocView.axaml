<!-- src/QuanLyDKHP.App/Views/MonHocView.axaml -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:dtos="using:QuanLyDKHP.Core.Dtos"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="QuanLyDKHP.App.Views.MonHocView"
             x:DataType="vm:MonHocViewModel">

    <UserControl.Styles>
        <!-- Style cho Segmented Control (Pill Button Group) -->
        <Style Selector="ListBox.segmented-bar">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Height" Value="38" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BrushPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushOnPrimary}" />
        </Style>

        <!-- Nút thao tác nhanh trên từng hàng -->
        <Style Selector="Button.row-action">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.row-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        </Style>
        <Style Selector="Button.row-action.delete:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushBadgeDangerBg}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24">

        <!-- 1. Header & Status -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Môn học" Classes="h1" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DanhSach.Count, StringFormat='{}{0} môn'}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" />
                </Border>
            </StackPanel>

            <Border Grid.Column="2"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Classes="status" Classes.error="{Binding IsStatusError}" />
            </Border>
        </Grid>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,12">
            <!-- Search bar -->
            <TextBox Grid.Column="0"
                     Width="380" Height="38"
                     Text="{Binding TuKhoa, Mode=TwoWay}"
                     PlaceholderText="Tìm nhanh mã hoặc tên môn học..."
                     Classes="clearButton"
                     CornerRadius="8"
                     VerticalContentAlignment="Center"
                     Margin="0,0,12,0">
                <TextBox.InnerLeftContent>
                    <materialIcons:MaterialIcon Kind="Magnify"
                                                Width="16" Height="16"
                                                Margin="10,0,4,0"
                                                Foreground="{DynamicResource BrushTextSecondary}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- Segmented Control -->
            <ListBox Grid.Column="1"
                     Classes="segmented-bar"
                     SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                     SelectionMode="Single"
                     Margin="0,0,12,0">
                <ListBoxItem Content="Tên A → Z" />
                <ListBoxItem Content="Tên Z → A" />
                <ListBoxItem Content="Mã môn" />
            </ListBox>

            <!-- Action buttons -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{Binding ExportExcelCommand}" Classes="btn-secondary" Height="38" Padding="14,0" CornerRadius="8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="FileExcelOutline" Width="16" Height="16" Foreground="{DynamicResource BrushTextPrimary}" />
                        <TextBlock Text="Xuất Excel" VerticalAlignment="Center" FontWeight="Medium" />
                    </StackPanel>
                </Button>

                <Button Command="{Binding ThemCommand}" Classes="btn-primary" Height="38" Padding="16,0" CornerRadius="8" Cursor="Hand" IsVisible="{Binding CanThemSuaXoa}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16" Foreground="{DynamicResource BrushOnPrimary}" />
                        <TextBlock Text="Thêm môn học" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 3. Thanh thao tác hàng loạt (Bulk Action Bar) -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasSelectedItems}"
                Background="{DynamicResource BrushBadgeInfoBg}"
                BorderBrush="{DynamicResource BrushBadgeInfoBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,8"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Đã chọn:" FontWeight="Medium" Foreground="{DynamicResource BrushBadgeInfoFg}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource BrushBadgeInfoBorder}" CornerRadius="10" Padding="8,2">
                        <TextBlock Text="{Binding SelectedCount, StringFormat='{}{0} môn'}" FontWeight="Bold" Foreground="{DynamicResource BrushBadgeInfoFg}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Button Command="{Binding SaoChepCacMaMonDaChonCommand}"
                            Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBadgeInfoBorder}" BorderThickness="1"
                            Height="32" Padding="12,0" CornerRadius="6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" Foreground="{DynamicResource BrushBadgeInfoFg}" />
                            <TextBlock Text="Sao chép các mã môn đã chọn" Foreground="{DynamicResource BrushBadgeInfoFg}" FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding XoaCacMonDaChonCommand}"
                            Background="{DynamicResource BrushBadgeDangerBg}" BorderBrush="{DynamicResource BrushBadgeDangerBorder}" BorderThickness="1"
                            Height="32" Padding="12,0" CornerRadius="6" Cursor="Hand"
                            IsVisible="{Binding CanThemSuaXoa}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource BrushBadgeDangerFg}" />
                            <TextBlock Text="Xóa các môn đã chọn" Foreground="{DynamicResource BrushBadgeDangerFg}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BoChonTatCaCommand}"
                            Background="Transparent" BorderThickness="0" Height="32" Width="32" Padding="0" Cursor="Hand"
                            ToolTip.Tip="Bỏ chọn tất cả">
                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource BrushTextSecondary}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Bar -->
        <ProgressBar Grid.Row="3"
                     Height="2"
                     HorizontalAlignment="Stretch"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,0,0,8" />

        <!-- 4. DataGrid -->
        <Border Grid.Row="4" Classes="table-container">
            <DataGrid x:Name="MonHocDataGrid"
                      ItemsSource="{Binding DanhSach}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="46"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto">

            <!-- ContextMenu cấp DataGrid: dùng chung an toàn tuyệt đối, tránh lỗi "Control already has a visual parent" -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Sao chép mã môn"
                              Command="{Binding SaoChepMaMonCommand}"
                              CommandParameter="{Binding #MonHocDataGrid.SelectedItem}">
                        <MenuItem.Icon>
                            <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource BrushTextPrimary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Sửa môn học" 
                              Command="{Binding SuaCommand}"
                              CommandParameter="{Binding #MonHocDataGrid.SelectedItem}"
                              IsEnabled="{Binding CanThemSuaXoa}">
                        <MenuItem.Icon>
                            <materialIcons:MaterialIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource BrushTextPrimary}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Xóa môn học" 
                              Foreground="{DynamicResource BrushDanger}"
                              Command="{Binding XoaCommand}"
                              CommandParameter="{Binding #MonHocDataGrid.SelectedItem}"
                              IsEnabled="{Binding CanThemSuaXoa}">
                        <MenuItem.Icon>
                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="{DynamicResource BrushDanger}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Checkbox HeaderTemplate chuẩn cho Avalonia, tắt compiled binding để tránh InvalidCastException -->
                <DataGridTemplateColumn Width="46">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <CheckBox IsChecked="{ReflectionBinding DataContext.IsAllSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Command="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).CapNhatSoLuongChonCommand}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Mã môn -->
                <DataGridTemplateColumn Header="Mã môn" Width="Auto" SortMemberPath="MaMon">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding MaMon}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Tên môn -->
                <DataGridTemplateColumn Header="Tên môn" Width="*" MinWidth="200" SortMemberPath="TenMon">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding TenMon}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TenMon}" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Các cột tín chỉ -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="TC LT" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding SoTinChiLT}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="TC TH" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding SoTinChiTH}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Tổng" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding TongTinChi}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Bậc ĐT -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Bậc ĐT" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <TextBlock Text="{Binding BacDaoTao}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Số LHP mở -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Số LHP mở" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"
                                    Background="{DynamicResource BrushSurfaceAlt}"
                                    CornerRadius="10" Padding="10,2">
                                <TextBlock Text="{Binding SoLhpDangMo}" FontWeight="Medium" HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Thao tác nhanh (Chỉ nhận chuột trái: ClickMode=Release, triệt tiêu ContextMenu) -->
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="Thao tác" HorizontalAlignment="Center" />
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:MonHocDto">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                <Button Classes="row-action"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).SuaCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).CanThemSuaXoa}"
                                        ToolTip.Tip="Chỉnh sửa">
                                    <materialIcons:MaterialIcon Kind="PencilOutline" Width="15" Height="15" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Button>

                                <Button Classes="row-action delete"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).XoaCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].((vm:MonHocViewModel)DataContext).CanThemSuaXoa}"
                                        ToolTip.Tip="Xóa">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="{DynamicResource BrushDanger}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>