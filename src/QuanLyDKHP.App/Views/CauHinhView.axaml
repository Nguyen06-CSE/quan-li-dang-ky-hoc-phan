<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:coreDtos="using:QuanLyDKHP.Core.Dtos"
             x:Class="QuanLyDKHP.App.Views.CauHinhView"
             x:DataType="vm:CauHinhViewModel">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <!-- 1. Header & Status Banner -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Cấu hình hệ thống &amp; Sao lưu dữ liệu" Classes="h1" FontWeight="Bold" FontSize="22" />
                <TextBlock Text="Thiết lập tham số tín chỉ/học phí và quản lý lịch sử phiên bản sao lưu CSDL (Git Local &amp; Gói Backup)"
                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="13"/>
            </StackPanel>

            <!-- Status Banner -->
            <Border Grid.Column="1"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8" Padding="14,8"
                    VerticalAlignment="Center" MaxWidth="520">
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap"
                           Classes="status" Classes.error="{Binding IsStatusError}" />
            </Border>
        </Grid>

        <!-- 2. TabControl phân tách không gian hiển thị rộng rãi -->
        <TabControl Grid.Row="1" Padding="0,12,0,0">

            <!-- ==================== TAB 1: THÔNG SỐ HỆ THỐNG ==================== -->
            <TabItem Header="Thông số Tín chỉ &amp; Học phí" FontSize="14" FontWeight="SemiBold">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Border Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="24"
                            MaxWidth="780" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <StackPanel Spacing="20">
                            <TextBlock Text="GIỚI HẠN TÍN CHỈ HỌC KỲ" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimaryDark}"/>

                            <Grid ColumnDefinitions="280,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Số tín chỉ tối thiểu / học kỳ:" FontWeight="SemiBold"/>
                                    <TextBlock Text="Số TC tối thiểu để hoàn tất đăng ký" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding SoTinChiToiThieu, Mode=TwoWay}"
                                               Minimum="1" Maximum="50" Increment="1"
                                               FormatString="0" />
                            </Grid>

                            <Grid ColumnDefinitions="280,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Số tín chỉ tối đa / học kỳ:" FontWeight="SemiBold"/>
                                    <TextBlock Text="Phải lớn hơn số tín chỉ tối thiểu" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding SoTinChiToiDa, Mode=TwoWay}"
                                               Minimum="1" Maximum="50" Increment="1"
                                               FormatString="0" />
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,6"/>

                            <TextBlock Text="ĐƠN GIÁ TÍN CHỈ (VNĐ)" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimaryDark}"/>

                            <Grid ColumnDefinitions="280,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Đơn giá 1 TC Lý thuyết:" FontWeight="SemiBold"/>
                                    <TextBlock Text="Áp dụng khi tính học phí tín chỉ LT" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding DonGiaTinChiLT, Mode=TwoWay}"
                                               Minimum="0" Maximum="10000000" Increment="50000"
                                               FormatString="###,###,##0" />
                            </Grid>

                            <Grid ColumnDefinitions="280,*">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Đơn giá 1 TC Thực hành:" FontWeight="SemiBold"/>
                                    <TextBlock Text="Áp dụng khi tính học phí tín chỉ TH" Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1"
                                               Value="{Binding DonGiaTinChiTH, Mode=TwoWay}"
                                               Minimum="0" Maximum="10000000" Increment="50000"
                                               FormatString="###,###,##0" />
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BrushBorder}" Margin="0,6"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                                <Button Content="Tải lại" Command="{Binding LoadCauHinhCommand}" Classes="btn-secondary"/>
                                <Button Content="Lưu cấu hình" Command="{Binding LuuCauHinhCommand}" Classes="btn-primary"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ==================== TAB 2: SAO LƯU & KHÔI PHỤC CSDL ==================== -->
            <TabItem Header="Sao lưu &amp; Khôi phục CSDL (Git &amp; File)" FontSize="14" FontWeight="SemiBold" IsSelected="True">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,4,0,0">

                    <!-- Hàng 1: Thanh chỉ số trạng thái CSDL + Nút Import file Backup -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BrushSurfaceAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,*,*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="CSDL CHÍNH (LOCAL SQLITE)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="quanlydkhp.db (WAL Mode)" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding BackupStatus.FormattedSize, StringFormat='Dung lượng: {0}', FallbackValue='Dung lượng: 0 KB'}"
                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="KHO LỊCH SỬ GIT LOCAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock Text="{Binding BackupStatus.TotalCommits, StringFormat='{}{0} phiên bản (commits)', FallbackValue='0 phiên bản'}"
                                           FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding BackupStatus.LastLocalBackupAt, StringFormat='Gần nhất: {0:dd/MM/yyyy HH:mm}', FallbackValue='Chưa sao lưu'}"
                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="YÊU CẦU ĐỊNH DẠNG FILE IMPORT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushPrimaryDark}"/>
                                <TextBlock Text="Chỉ chấp nhận tệp .dkhp-backup.zip / .zip được xuất (Export) trực tiếp từ chương trình (có chữ ký QuanLyDKHP-Backup-v1 &amp; kiểm tra toàn vẹn SHA-256)."
                                           TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11.5"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Nhập file Backup &amp; Ghi đè..."
                                        Command="{Binding ChonFileImportBackupCommand}"
                                        IsEnabled="{Binding !IsBackingUp}"
                                        Classes="btn-secondary"
                                        ToolTip.Tip="Chọn tệp .dkhp-backup.zip đã xuất từ chương trình để khôi phục đè lên CSDL hiện tại"/>
                                <Button Content="Đồng bộ DB Host"
                                        Command="{Binding DongBoLenDbHostCommand}"
                                        IsEnabled="{Binding !IsBackingUp}"
                                        Classes="btn-secondary"
                                        ToolTip.Tip="Đẩy các bản ghi thay đổi lên máy chủ PostgreSQL dự phòng (nếu có cấu hình)"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hàng 2: Thanh tạo bản sao lưu Git mới -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Tạo mốc sao lưu mới:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding GhiChuSaoLuu, Mode=TwoWay}"
                                     PlaceholderText="Nhập ghi chú cho phiên bản sao lưu này (ví dụ: Trước khi chốt học phí HK1)..."
                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Grid.Column="2"
                                    Content="Sao lưu ngay (Git)"
                                    Command="{Binding TaoBanSaoLuuGitCommand}"
                                    IsEnabled="{Binding !IsBackingUp}"
                                    Classes="btn-primary" Margin="0,0,8,0"/>
                            <Button Grid.Column="3"
                                    Content="Làm mới"
                                    Command="{Binding LoadBackupInfoCommand}"
                                    IsEnabled="{Binding !IsBackingUp}"
                                    Classes="btn-secondary"/>
                        </Grid>
                    </Border>

                    <!-- Hàng 3: Master-Detail Split View (Trái: Danh sách lịch sử | Phải: Chi tiết thay đổi & Thao tác) -->
                    <Grid Grid.Row="2" ColumnDefinitions="1.05*,14,1.25*">

                        <!-- CỘT TRÁI: Danh sách các phiên bản sao lưu -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid RowDefinitions="Auto,*">
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <TextBlock Grid.Column="0" Text="DANH SÁCH PHIÊN BẢN (CLICK ĐỂ XEM CHI TIẾT)"
                                               FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimaryDark}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BackupHistory.Count, StringFormat='{}{0} bản lưu'}"
                                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding BackupHistory}"
                                         SelectedItem="{Binding SelectedBackupCommit, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource BrushBorder}"
                                         CornerRadius="8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="coreDtos:BackupCommitInfoDto">
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,4">
                                                <!-- Cột thời gian & mã SHA -->
                                                <StackPanel Grid.Column="0" Spacing="4" Width="130" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CommittedAtLocal, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                                               FontWeight="Bold" FontSize="12.5"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border Background="{DynamicResource BrushSurfaceAlt}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                            <TextBlock Text="{Binding ShortSha}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding BackupType}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Cột nội dung tóm tắt thay đổi -->
                                                <StackPanel Grid.Column="1" Spacing="3" Margin="10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Message}" MaxLines="1" TextTrimming="CharacterEllipsis" FontWeight="Medium" FontSize="12.5"/>
                                                    <TextBlock Text="{Binding ChangedTablesSummary}" MaxLines="1" TextTrimming="CharacterEllipsis"
                                                               FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}"/>
                                                </StackPanel>

                                                <!-- Nút thao tác nhanh trên dòng -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Button Content="Xuất file"
                                                            Command="{Binding $parent[UserControl].((vm:CauHinhViewModel)DataContext).XuatFileBackupCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn-secondary" FontSize="11" Padding="8,4"
                                                            ToolTip.Tip="Xuất phiên bản này thành tệp .dkhp-backup.zip"/>
                                                    <Button Content="Khôi phục"
                                                            Command="{Binding $parent[UserControl].((vm:CauHinhViewModel)DataContext).MoXacNhanKhoiPhucCommand}"
                                                            CommandParameter="{Binding}"
                                                            Classes="btn-primary" FontSize="11" Padding="8,4"
                                                            ToolTip.Tip="Khôi phục CSDL về phiên bản này"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- CỘT PHẢI: Chi tiết phiên bản đang chọn (Inspector Panel) -->
                        <Border Grid.Column="2"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <Panel>
                                <!-- Trạng thái chưa chọn commit -->
                                <TextBlock IsVisible="{Binding SelectedCommitDetail, Converter={x:Static ObjectConverters.IsNull}}"
                                           Text="Hãy chọn một phiên bản sao lưu ở danh sách bên trái để xem chi tiết biến động dữ liệu."
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" FontSize="13"/>

                                <!-- Nội dung chi tiết khi đã chọn commit -->
                                <Grid IsVisible="{Binding SelectedCommitDetail, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      RowDefinitions="Auto,Auto,Auto,*">

                                    <!-- Header của bản sao lưu đang chọn + Nút Xuất file / Khôi phục -->
                                    <Border Grid.Row="0"
                                            Background="{DynamicResource BrushSurfaceAlt}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding SelectedCommitDetail.ShortSha, StringFormat='PHIÊN BẢN #{0}'}"
                                                               FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushPrimaryDark}"/>
                                                    <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                                        <TextBlock Text="{Binding SelectedCommitDetail.BackupType}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SelectedCommitDetail.CommittedAtLocal, StringFormat='• {0:dd/MM/yyyy HH:mm:ss}'}"
                                                               FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SelectedCommitDetail.FullMessage}" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Button Content="Xuất ra file (.zip)"
                                                        Command="{Binding XuatFileBackupCommand}"
                                                        CommandParameter="{Binding SelectedBackupCommit}"
                                                        Classes="btn-secondary" Padding="10,6" FontSize="12"/>
                                                <Button Content="Khôi phục bản này"
                                                        Command="{Binding MoXacNhanKhoiPhucCommand}"
                                                        CommandParameter="{Binding SelectedBackupCommit}"
                                                        Classes="btn-primary" Padding="10,6" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Bảng thống kê 8 bảng dữ liệu trong phiên bản -->
                                    <TextBlock Grid.Row="1" Text="THỐNG KÊ BIẾN ĐỘNG THEO BẢNG (SO VỚI BẢN TRƯỚC):"
                                               FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>

                                    <Border Grid.Row="2"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                                        <ItemsControl ItemsSource="{Binding SelectedCommitDetail.TableStats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="coreDtos:BackupTableDiffDto">
                                                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="6,4" Margin="4,0">
                                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TotalRecordsInSnapshot, StringFormat='({0} dòng)'}"
                                                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0"/>
                                                            <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ChangeBadge}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Danh sách chi tiết các dòng bản ghi thêm/xóa -->
                                    <Grid Grid.Row="3" RowDefinitions="Auto,*">
                                        <TextBlock Grid.Row="0" Text="CHI TIẾT CÁC BẢN GHI THAY ĐỔI ([+] THÊM MỚI/CẬP NHẬT | [-] XÓA/CŨ):"
                                                   FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,6"/>

                                        <Border Grid.Row="1"
                                                Background="{DynamicResource BrushSurfaceAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="6" Padding="10">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Spacing="4">
                                                    <TextBlock IsVisible="{Binding !SelectedCommitDetail.ReadableChanges.Count}"
                                                               Text="Không có bản ghi nào thay đổi so với phiên bản liền trước."
                                                               Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" FontStyle="Italic"/>
                                                    <ItemsControl ItemsSource="{Binding SelectedCommitDetail.ReadableChanges}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}"
                                                                           FontFamily="Consolas, monospace"
                                                                           FontSize="11.5"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,2"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Panel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Overlay Dialog 1: Hỏi tính lại học phí -->
        <Border Grid.RowSpan="2" Background="#40000000" IsVisible="{Binding HienThiHoiTinhLaiHocPhi}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="24" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #30000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Xác nhận tính lại học phí" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushPrimaryDark}"/>
                    <TextBlock Text="Cấu hình hệ thống đã được lưu thành công. Bạn có muốn tính lại học phí cho toàn bộ sinh viên trong học kỳ hiện hành theo đơn giá mới không?"
                               TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Không, để sau" Command="{Binding TuChoiTinhLaiHocPhiCommand}" Classes="btn-secondary"/>
                        <Button Content="Có, tính lại ngay" Command="{Binding DongYTinhLaiHocPhiCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay Dialog 2: Xác nhận khôi phục CSDL từ Git Commit -->
        <Border Grid.RowSpan="2" Background="#50000000" IsVisible="{Binding HienThiXacNhanKhoiPhuc}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="24" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #30000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Xác nhận khôi phục cơ sở dữ liệu" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushPrimaryDark}"/>
                    <TextBlock Text="{Binding ThongBaoKhoiPhuc}"
                               TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding HuyKhoiPhucCommand}" Classes="btn-secondary"/>
                        <Button Content="Khôi phục ngay" Command="{Binding XacNhanKhoiPhucCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overlay Dialog 3: Xác nhận Import & Ghi đè từ file Backup (.dkhp-backup.zip) -->
        <Border Grid.RowSpan="2" Background="#50000000" IsVisible="{Binding HienThiXacNhanImportFile}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="100">
            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="24" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #30000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Xác nhận Nhập file Backup &amp; Ghi đè CSDL" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource BrushPrimaryDark}"/>
                    <TextBlock Text="{Binding ThongBaoImportFile}"
                               TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
                        <Button Content="Hủy bỏ" Command="{Binding HuyImportGhiDeCommand}" Classes="btn-secondary"/>
                        <Button Content="Xác nhận Ghi đè CSDL" Command="{Binding XacNhanImportGhiDeCommand}" Classes="btn-primary"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
