<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuanLyDKHP.App.ViewModels"
        x:Class="QuanLyDKHP.App.Views.SinhVienEditDialog"
        x:DataType="vm:SinhVienEditDialogViewModel"
        Title="Thông tin sinh viên"
        Width="450" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="16">
            <TextBlock Text="{Binding IsEditMode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="h2" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}" 
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                       TextWrapping="Wrap" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="120,*" RowSpacing="12" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã sinh viên *:" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaSV}" IsReadOnly="{Binding IsEditMode}" PlaceholderText="Ví dụ: 20110001" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Họ và tên *:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HoTen}" PlaceholderText="Nhập họ và tên đầy đủ..." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Lớp sinh hoạt:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LopSinhHoat}" PlaceholderText="Ví dụ: 20TCLC_DT" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Khóa học:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding KhoaHoc}" PlaceholderText="Ví dụ: 2020-2024" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Command="{Binding CancelCommand}" Content="Hủy" Classes="btn-secondary" MinWidth="90" />
            <Button Command="{Binding SaveCommand}" Content="Lưu" Classes="btn-primary" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
