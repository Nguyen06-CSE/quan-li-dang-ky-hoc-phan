<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuanLyDKHP.App.ViewModels"
        x:Class="QuanLyDKHP.App.Views.MonHocEditDialog"
        x:DataType="vm:MonHocEditDialogViewModel"
        Title="Thông tin môn học"
        Width="460" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <Grid RowDefinitions="*,Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="16">
            <TextBlock Text="Thông tin môn học" Classes="h2" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}" 
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" 
                       TextWrapping="Wrap" />

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="130,*" RowSpacing="12" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã môn học *:" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaMon}" IsReadOnly="{Binding IsEditMode}" PlaceholderText="Ví dụ: INT1001" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên môn học *:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TenMon}" PlaceholderText="Ví dụ: Lập trình C++" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Số TC Lý thuyết:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SoTinChiLT}" Minimum="0" Maximum="20" FormatString="0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Số TC Thực hành:" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding SoTinChiTH}" Minimum="0" Maximum="20" FormatString="0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Bậc đào tạo:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" SelectedItem="{Binding BacDaoTao}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Đại học" />
                    <ComboBoxItem Content="Cao đẳng" />
                    <ComboBoxItem Content="Thạc sĩ" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
            <Button Command="{Binding CancelCommand}" Content="Hủy" Classes="btn-secondary" MinWidth="90" />
            <Button Command="{Binding SaveCommand}" Content="Lưu" Classes="btn-primary" MinWidth="90" />
        </StackPanel>
    </Grid>
</Window>
