<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:dtos="using:QuanLyDKHP.App.Dtos"
             xmlns:entities="using:QuanLyDKHP.Core.Entities"
             x:Class="QuanLyDKHP.App.Views.HocKyLopHocPhanView"
             x:DataType="vm:HocKyLopHocPhanViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        <!-- 1. Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="Học kỳ / Lớp học phần" Classes="h1" VerticalAlignment="Center" />

            <!-- Status Message Banner -->
            <Border Grid.Column="1" VerticalAlignment="Center" 
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,6">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding IsStatusError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Border>
        </Grid>

        <!-- 2. Khối chọn/quản lý Học kỳ (Top section) -->
        <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceAlt}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Học kỳ:" VerticalAlignment="Center" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding DanhSachHocKy}" 
                              SelectedItem="{Binding SelectedHocKy}" 
                              Width="260">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="entities:HocKy">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding TenHocKy}"/>
                                    <Border Background="{DynamicResource BrushSuccess}" 
                                            CornerRadius="4" Padding="4,2" 
                                            IsVisible="{Binding DangMo}">
                                        <TextBlock Text="ĐANG MỞ" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="Đặt làm HK hiện hành" 
                            Command="{Binding DatHocKyHienHanhCommand}" 
                            CommandParameter="{Binding SelectedHocKy}"
                            IsVisible="{Binding CanThemSuaXoa}" 
                            Classes="secondary" />
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="+ Thêm học kỳ" 
                        Command="{Binding ThemHocKyCommand}" 
                        IsVisible="{Binding CanThemSuaXoa}" 
                        Classes="primary"/>
            </Grid>
        </Border>

        <!-- 3. Thanh công cụ LHP (Middle toolbar) -->
        <Grid Grid.Row="2" ColumnDefinitions="280,260,*,Auto" Margin="0,0,0,16">
            <TextBox Grid.Column="0" Text="{Binding TuKhoaLHP, Mode=TwoWay}" PlaceholderText="Tìm theo Mã LHP hoặc Tên môn..." Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1" 
                      ItemsSource="{Binding DanhSachMonHocFilter}" 
                      SelectedItem="{Binding SelectedMonFilter}"
                      HorizontalAlignment="Stretch" Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="entities:MonHoc">
                        <TextBlock Text="{Binding TenMon}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Button Grid.Column="3" 
                    Content="+ Thêm LHP" 
                    Command="{Binding ThemLhpCommand}" 
                    IsVisible="{Binding CanThemSuaXoa}" 
                    Classes="primary"/>
        </Grid>

        <!-- 4. DataGrid LHP (Bottom main table) -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding DanhSachLHP}" AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="All" BorderThickness="1" BorderBrush="{DynamicResource BrushBorder}" CornerRadius="6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã LHP" Binding="{Binding MaLHP}" Width="130" />
                <DataGridTextColumn Header="Môn học" Binding="{Binding TenMon}" Width="*" />
                
                <!-- GV Phụ trách -->
                <DataGridTemplateColumn Header="Giảng viên" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <Panel Margin="8,0">
                                <TextBlock Text="{Binding TenGiangVien}" 
                                           Foreground="{DynamicResource BrushWarning}" 
                                           IsVisible="{Binding !CoGiangVien}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TenGiangVien}" 
                                           IsVisible="{Binding CoGiangVien}" VerticalAlignment="Center"/>
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Loại hình ĐT" Binding="{Binding LoaiHinhDT}" Width="120" />
                
                <!-- Sĩ số đk / Sĩ số tối đa + Progress bar -->
                <DataGridTemplateColumn Header="Sĩ số (ĐK / Tối đa)" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <StackPanel VerticalAlignment="Center" Margin="8,4" Spacing="4">
                                <TextBlock Text="{Binding SiSoHienThi}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                <ProgressBar Value="{Binding TyLeLapDay}" Maximum="100" Height="8" CornerRadius="4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Giảng dạy Online -->
                <DataGridTemplateColumn Header="Online" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <TextBlock Text="✓" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource BrushSuccess}" FontWeight="Bold"
                                       IsVisible="{Binding GiangDayOnline}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Thao tác -->
                <DataGridTemplateColumn Header="Thao tác" Width="110" IsVisible="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).CanThemSuaXoa}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <Button Content="✏️" ToolTip.Tip="Sửa LHP" 
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).SuaLhpCommand}" 
                                        CommandParameter="{Binding}" Padding="6,4" />
                                <Button Content="🗑️" ToolTip.Tip="Xóa LHP" 
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).XoaLhpCommand}" 
                                        CommandParameter="{Binding}" Padding="6,4" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
