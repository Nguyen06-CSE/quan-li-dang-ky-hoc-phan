<!-- src/QuanLyDKHP.App/Views/HocKyLopHocPhanView.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:dtos="using:QuanLyDKHP.App.Dtos"
             xmlns:entities="using:QuanLyDKHP.Core.Entities"
             x:Class="QuanLyDKHP.App.Views.HocKyLopHocPhanView"
             x:DataType="vm:HocKyLopHocPhanViewModel">

    <UserControl.Styles>
        <!-- Style cho Segmented Control (Pill Button Group - đồng bộ với Sinh viên & Môn học) -->
        <Style Selector="ListBox.segmented-bar">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="Height" Value="38" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem:selected">
            <Setter Property="Background" Value="#93C5FD" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="ListBox.segmented-bar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#93C5FD" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>

        <!-- Nút thao tác nhanh trên từng hàng (đồng bộ Sinh viên & Môn học) -->
        <Style Selector="Button.row-action">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.row-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
        </Style>
        <Style Selector="Button.row-action.edit:pointerover">
            <Setter Property="Background" Value="#DBEAFE" />
        </Style>
        <Style Selector="Button.row-action.copy:pointerover">
            <Setter Property="Background" Value="#E0E7FF" />
        </Style>
        <Style Selector="Button.row-action.delete:pointerover">
            <Setter Property="Background" Value="#FEE2E2" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24">

        <!-- 1. Header & Status Message -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Học kỳ &amp; Lớp học phần" Classes="h1" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
                
                <!-- Badge đếm số lượng LHP -->
                <Border Background="{DynamicResource BrushSurfaceAlt}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DanhSachLHP.Count, StringFormat='{}{0} lớp học phần'}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextSecondary}" />
                </Border>

                <!-- Badge trạng thái bộ lọc nếu đang có điều kiện tìm kiếm/lọc môn -->
                <Border IsVisible="{Binding HasAnyFilter}"
                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="Đang lọc kết quả"
                               FontSize="12" FontWeight="Medium" Foreground="#1D4ED8" />
                </Border>
            </StackPanel>

            <!-- Status Message Banner -->
            <Border Grid.Column="2"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource BrushSurfaceAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="6" Padding="12,6"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Classes="status" Classes.error="{Binding IsStatusError}" />
            </Border>
        </Grid>

        <!-- 2. Khối Quản lý Học kỳ (Sleek Semester Card) -->
        <Border Grid.Row="1"
                Background="{DynamicResource BrushSurfaceAlt}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Icon Lịch học kỳ -->
                    <PathIcon Data="M 19 4 H 18 V 2 H 16 V 4 H 8 V 2 H 6 V 4 H 5 C 3.89 4 3.01 4.9 3.01 6 L 3 20 C 3 21.1 3.89 22 5 22 H 19 C 20.1 22 21 21.1 21 20 V 6 C 21 4.9 20.1 4 19 4 Z M 19 20 H 5 V 9 H 19 V 20 Z"
                              Width="15" Height="15"
                              Foreground="{DynamicResource BrushPrimaryDark}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Học kỳ:"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource BrushTextPrimary}"
                               VerticalAlignment="Center" />

                    <!-- ComboBox chọn Học kỳ -->
                    <ComboBox ItemsSource="{Binding DanhSachHocKy}"
                              SelectedItem="{Binding SelectedHocKy}"
                              Width="260"
                              Height="36"
                              CornerRadius="6"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="entities:HocKy">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TenHocKy}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Background="#DCFCE7"
                                            BorderBrush="#86EFAC"
                                            BorderThickness="1"
                                            CornerRadius="4" Padding="5,1"
                                            IsVisible="{Binding DangMo}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="ĐANG MỞ" FontSize="10" Foreground="#15803D" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Nút đặt HK hiện hành -->
                    <Button Command="{Binding DatHocKyHienHanhCommand}"
                            CommandParameter="{Binding SelectedHocKy}"
                            IsVisible="{Binding CanThemSuaXoa}"
                            Classes="btn-secondary"
                            Height="36" Padding="12,0"
                            CornerRadius="6" Cursor="Hand"
                            ToolTip.Tip="Đặt học kỳ đang chọn làm học kỳ hiện hành của hệ thống">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="M 9 16.17 L 4.83 12 L 3.41 13.41 L 9 19 L 21 7 L 19.59 5.59 Z"
                                      Width="13" Height="13"
                                      Foreground="{DynamicResource BrushSuccess}" />
                            <TextBlock Text="Đặt làm HK hiện hành" VerticalAlignment="Center" FontWeight="Medium" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nút thêm học kỳ mới -->
                <Button Grid.Column="2"
                        Command="{Binding ThemHocKyCommand}"
                        IsVisible="{Binding CanThemSuaXoa}"
                        Classes="btn-primary"
                        Height="36" Padding="14,0"
                        CornerRadius="6" Cursor="Hand"
                        ToolTip.Tip="Tạo thêm học kỳ niên khóa mới">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"
                                  Width="13" Height="13" />
                        <TextBlock Text="Thêm học kỳ" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Toolbar LHP (Search + Môn filter + Segmented Sort + Thêm LHP) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
            <!-- 3.1. Ô tìm kiếm mở rộng -->
            <TextBox Grid.Column="0"
                     MinWidth="240" Height="38"
                     Text="{Binding TuKhoaLHP, Mode=TwoWay}"
                     PlaceholderText="Tìm nhanh theo Mã LHP hoặc Tên môn học..."
                     Classes="clearButton"
                     CornerRadius="8"
                     VerticalContentAlignment="Center"
                     Margin="0,0,10,0">
                <TextBox.InnerLeftContent>
                    <PathIcon Data="M 15.5 14 L 14.71 14 L 14.43 13.73 C 15.41 12.59 16 11.11 16 9.5 C 16 5.91 13.09 3 9.5 3 C 5.91 3 3 5.91 3 9.5 C 3 13.09 5.91 16 9.5 16 C 11.11 16 12.59 15.41 13.73 14.43 L 14 14.71 L 14 15.5 L 19 20.49 L 20.49 19 L 15.5 14 Z M 9.5 14 C 7.01 14 5 11.99 5 9.5 C 5 7.01 7.01 5 9.5 5 C 11.99 5 14 7.01 14 9.5 C 14 11.99 11.99 14 9.5 14 Z"
                              Width="15" Height="15" Margin="10,0,4,0" Foreground="{DynamicResource BrushTextSecondary}" />
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- 3.2. ComboBox lọc theo Môn học -->
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DanhSachMonHocFilter}"
                      SelectedItem="{Binding SelectedMonFilter}"
                      Width="230" Height="38"
                      CornerRadius="8"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="entities:MonHoc">
                        <TextBlock Text="{Binding TenMon}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 3.3. Nút đặt lại bộ lọc -->
            <Button Grid.Column="2"
                    Command="{Binding DatLaiBoLocCommand}"
                    IsVisible="{Binding HasAnyFilter}"
                    Classes="btn-icon-ghost"
                    Height="38" Padding="8,0" Margin="0,0,8,0"
                    ToolTip.Tip="Xóa tất cả điều kiện tìm kiếm và lọc">
                <PathIcon Data="M 19 6.41 L 17.59 5 L 12 10.59 L 6.41 5 L 5 6.41 L 10.59 12 L 5 17.59 L 6.41 19 L 12 13.41 L 17.59 19 L 19 17.59 L 13.41 12 L 19 6.41 Z"
                          Width="13" Height="13" Foreground="{DynamicResource BrushDanger}" />
            </Button>

            <!-- 3.4. Segmented Control sắp xếp nhanh -->
            <ListBox Grid.Column="3"
                     Classes="segmented-bar"
                     SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                     SelectionMode="Single"
                     Margin="0,0,10,0">
                <ListBoxItem Content="Môn A → Z" />
                <ListBoxItem Content="Môn Z → A" />
                <ListBoxItem Content="Mã LHP" />
                <ListBoxItem Content="Sĩ số ↓" />
            </ListBox>

            <!-- 3.5. Nút Thêm Lớp học phần -->
            <Button Grid.Column="4"
                    Command="{Binding ThemLhpCommand}"
                    IsVisible="{Binding CanThemSuaXoa}"
                    Classes="btn-primary"
                    Height="38" Padding="14,0"
                    CornerRadius="8" Cursor="Hand"
                    ToolTip.Tip="Mở hộp thoại tạo lớp học phần mới">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="M 19 13 L 13 13 L 13 19 L 11 19 L 11 13 L 5 13 L 5 11 L 11 11 L 11 5 L 13 5 L 13 11 L 19 11 L 19 13 Z"
                              Width="15" Height="15" />
                    <TextBlock Text="Thêm LHP" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 4. ProgressBar khi đang tải hoặc lọc -->
        <ProgressBar Grid.Row="3"
                     Height="2"
                     HorizontalAlignment="Stretch"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Margin="0,0,0,8" />

        <!-- 5. Bố cục Chính + Ngăn kéo Điều phối Lớp học phần (Sổ Tay Điều Phối Lớp - Nâng Cấp 2) -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
        <Border Grid.Column="0" Classes="table-container">
            <DataGrid x:Name="LhpDataGrid"
                      ItemsSource="{Binding DanhSachLHP}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      RowHeight="46"
                      CanUserResizeColumns="True"
                      HorizontalScrollBarVisibility="Auto"
                      DoubleTapped="OnDataGridDoubleTapped">

            <!-- ContextMenu chuẩn chỉ mở khi nhấp chuột phải -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Quản lý danh sách &amp; Điều phối SV trong lớp"
                              Command="{Binding MoBangDieuPhoiLopCommand}"
                              CommandParameter="{Binding #LhpDataGrid.SelectedItem}">
                        <MenuItem.Icon>
                            <PathIcon Data="M 16 11 C 17.66 11 18.99 9.66 18.99 8 C 18.99 6.34 17.66 5 16 5 C 14.34 5 13 6.34 13 8 C 13 9.66 14.34 11 16 11 Z M 8 11 C 9.66 11 10.99 9.66 10.99 8 C 10.99 6.34 9.66 5 8 5 C 6.34 5 5 6.34 5 8 C 5 9.66 6.34 11 8 11 Z M 8 13 C 5.67 13 1 14.17 1 16.5 V 19 H 15 V 16.5 C 15 14.17 10.33 13 8 13 Z M 16 13 C 15.71 13 15.38 13.02 15.03 13.05 C 16.19 13.89 17 15.02 17 16.5 V 19 H 23 V 16.5 C 23 14.17 18.33 13 16 13 Z"
                                      Width="14" Height="14" Foreground="#7C3AED" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sao chép mã LHP"
                              Command="{Binding SaoChepMaLhpCommand}"
                              CommandParameter="{Binding #LhpDataGrid.SelectedItem}">
                        <MenuItem.Icon>
                            <PathIcon Data="M 16 1 L 4 1 C 2.9 1 2 1.9 2 3 L 2 17 L 4 17 L 4 3 L 16 3 L 16 1 Z M 19 5 L 8 5 C 6.9 5 6 5.9 6 7 L 6 21 C 6 22.1 6.9 23 8 23 L 19 23 C 20.1 23 21 22.1 21 21 L 21 7 C 21 5.9 20.1 5 19 5 Z M 19 21 L 8 21 L 8 7 L 19 7 L 19 21 Z"
                                      Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Sửa lớp học phần"
                              Command="{Binding SuaLhpCommand}"
                              CommandParameter="{Binding #LhpDataGrid.SelectedItem}"
                              IsEnabled="{Binding CanThemSuaXoa}">
                        <MenuItem.Icon>
                            <PathIcon Data="M 3 17.25 L 3 21 L 6.75 21 L 17.81 9.94 L 14.06 6.19 L 3 17.25 Z M 20.71 7.04 C 21.1 6.65 21.1 6.02 20.71 5.63 L 18.37 3.29 C 17.98 2.9 17.35 2.9 16.96 3.29 L 15.13 5.12 L 18.88 8.87 L 20.71 7.04 Z"
                                      Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Xóa lớp học phần"
                              Foreground="#DC2626"
                              Command="{Binding XoaLhpCommand}"
                              CommandParameter="{Binding #LhpDataGrid.SelectedItem}"
                              IsEnabled="{Binding CanThemSuaXoa}">
                        <MenuItem.Icon>
                            <PathIcon Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                      Width="14" Height="14" Foreground="#DC2626" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- Cột 1: Mã LHP (in đậm) -->
                <DataGridTemplateColumn Header="Mã LHP" Width="130" MinWidth="115" SortMemberPath="MaLHP">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <TextBlock Text="{Binding MaLHP}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 2: Môn học (rộng rãi, hiển thị đầy đủ không bị co rút) -->
                <DataGridTemplateColumn Header="Môn học" Width="2*" MinWidth="200" SortMemberPath="TenMon">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <TextBlock Text="{Binding TenMon}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding TenMon}"
                                       Margin="10,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 3: Giảng viên phụ trách (có badge trạng thái phân công) -->
                <DataGridTemplateColumn Header="Giảng viên" Width="135" MinWidth="110" SortMemberPath="TenGiangVien">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <Panel VerticalAlignment="Center" Margin="8,0">
                                <!-- Đã phân công GV -->
                                <TextBlock Text="{Binding TenGiangVien}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding CoGiangVien}"
                                           ToolTip.Tip="{Binding TenGiangVien}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- Chưa phân công GV -->
                                <Border Background="#FEF3C7"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="6,2"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !CoGiangVien}">
                                    <TextBlock Text="Chưa phân công"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#D97706" />
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 4: Loại hình ĐT (hiển thị dạng Pill Tag) -->
                <DataGridTemplateColumn Header="Loại hình" Width="85" MinWidth="75" SortMemberPath="LoaiHinhDT">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <Border Background="{DynamicResource BrushSurfaceAlt}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="8,0">
                                <TextBlock Text="{Binding LoaiHinhDT, FallbackValue='CQ'}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 5: Lịch học -->
                <DataGridTemplateColumn Header="Lịch học" Width="135" MinWidth="115" SortMemberPath="LichHocHienThi">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <TextBlock Text="{Binding LichHocHienThi}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       ToolTip.Tip="{Binding LichHocHienThi}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 6: Sĩ số (ĐK / Tối đa) kèm ProgressBar hiển thị tỷ lệ lấp đầy -->
                <DataGridTemplateColumn Header="Sĩ số (ĐK/Tối đa)" Width="120" MinWidth="105" SortMemberPath="SiSoDangKy">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <StackPanel VerticalAlignment="Center" Margin="8,4" Spacing="4">
                                <TextBlock Text="{Binding SiSoHienThi}"
                                           HorizontalAlignment="Center"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" />
                                <ProgressBar Value="{Binding TyLeLapDay}"
                                             Maximum="100"
                                             Height="5"
                                             CornerRadius="3" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 7: Hình thức Online -->
                <DataGridTemplateColumn Header="Online" Width="68" MinWidth="58">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Background="#DBEAFE"
                                        BorderBrush="#93C5FD"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="6,2"
                                        IsVisible="{Binding GiangDayOnline}">
                                    <TextBlock Text="Online"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="#1D4ED8" />
                                </Border>
                                <TextBlock Text="--"
                                           Foreground="{DynamicResource BrushTextSecondary}"
                                           IsVisible="{Binding !GiangDayOnline}" />
                            </Panel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 8: Thao tác nhanh (Điều phối SV / Smart Import / Sao chép / Sửa / Xóa) -->
                <DataGridTemplateColumn Header="Thao tác" Width="170" MinWidth="160" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dtos:LopHocPhanDisplayDto">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Nút Mở Bảng Điều phối Danh sách Lớp (Nâng Cấp 2) -->
                                <Button Classes="row-action"
                                        Background="#F5F3FF"
                                        BorderBrush="#DDD6FE"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).MoBangDieuPhoiLopCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Mở Sổ tay Điều phối Lớp học phần (Xem DS SV, Chuyển nhóm 1-chạm, Điểm danh)">
                                    <PathIcon Data="M 16 11 C 17.66 11 18.99 9.66 18.99 8 C 18.99 6.34 17.66 5 16 5 C 14.34 5 13 6.34 13 8 C 13 9.66 14.34 11 16 11 Z M 8 11 C 9.66 11 10.99 9.66 10.99 8 C 10.99 6.34 9.66 5 8 5 C 6.34 5 5 6.34 5 8 C 5 9.66 6.34 11 8 11 Z M 8 13 C 5.67 13 1 14.17 1 16.5 V 19 H 15 V 16.5 C 15 14.17 10.33 13 8 13 Z M 16 13 C 15.71 13 15.38 13.02 15.03 13.05 C 16.19 13.89 17 15.02 17 16.5 V 19 H 23 V 16.5 C 23 14.17 18.33 13 16 13 Z"
                                              Width="14" Height="14" Foreground="#7C3AED" />
                                </Button>

                                <!-- Nút sao chép mã LHP -->
                                <Button Classes="row-action copy"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).SaoChepMaLhpCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Sao chép mã lớp học phần">
                                    <PathIcon Data="M 16 1 L 4 1 C 2.9 1 2 1.9 2 3 L 2 17 L 4 17 L 4 3 L 16 3 L 16 1 Z M 19 5 L 8 5 C 6.9 5 6 5.9 6 7 L 6 21 C 6 22.1 6.9 23 8 23 L 19 23 C 20.1 23 21 22.1 21 21 L 21 7 C 21 5.9 20.1 5 19 5 Z M 19 21 L 8 21 L 8 7 L 19 7 L 19 21 Z"
                                              Width="13" Height="13" Foreground="#2563EB" />
                                </Button>

                                <!-- Nút Smart Import Sinh Viên vào Lớp -->
                                <Button Classes="row-action"
                                        Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).NapSinhVienSmartCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="Nạp sinh viên vào lớp (Smart Import Studio)">
                                    <PathIcon Data="M 15 12 C 17.21 12 19 10.21 19 8 C 19 5.79 17.21 4 15 4 C 12.79 4 11 5.79 11 8 C 11 10.21 12.79 12 15 12 M 6 10 V 7 H 4 V 10 H 1 V 12 H 4 V 15 H 6 V 12 H 9 V 10 H 6 M 15 14 C 12.33 14 7 15.34 7 18 V 20 H 23 V 18 C 23 15.34 17.67 14 15 14 Z"
                                              Width="13" Height="13" Foreground="#059669" />
                                </Button>

                                <!-- Nút Sửa -->
                                <Button Classes="row-action edit"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).SuaLhpCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).CanThemSuaXoa}"
                                        ToolTip.Tip="Chỉnh sửa lớp học phần">
                                    <PathIcon Data="M 3 17.25 L 3 21 L 6.75 21 L 17.81 9.94 L 14.06 6.19 L 3 17.25 Z M 20.71 7.04 C 21.1 6.65 21.1 6.02 20.71 5.63 L 18.37 3.29 C 17.98 2.9 17.35 2.9 16.96 3.29 L 15.13 5.12 L 18.88 8.87 L 20.71 7.04 Z"
                                              Width="14" Height="14" Foreground="{DynamicResource BrushTextSecondary}" />
                                </Button>

                                <!-- Nút Xóa -->
                                <Button Classes="row-action delete"
                                        ClickMode="Release"
                                        ContextMenu="{x:Null}"
                                        Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).XoaLhpCommand}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).CanThemSuaXoa}"
                                        ToolTip.Tip="Xóa lớp học phần">
                                    <PathIcon Data="M 6 19 C 6 20.1 6.9 21 8 21 L 16 21 C 17.1 21 18 20.1 18 19 L 18 7 L 6 7 L 6 19 Z M 19 4 L 15.5 4 L 14.5 3 L 9.5 3 L 8.5 4 L 5 4 L 5 6 L 19 6 L 19 4 Z"
                                              Width="13" Height="13" Foreground="#EF4444" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>

        <!-- NGĂN KÉO ĐIỀU PHỐI LỚP HỌC PHẦN (SỔ TAY ĐIỀU PHỐI LỚP HỌC - NÂNG CẤP 2) -->
        <Border Grid.Column="1"
                Width="470"
                Margin="14,0,0,0"
                Background="{DynamicResource BrushBackground}"
                BorderBrush="{DynamicResource BrushPrimary}"
                BorderThickness="1.5"
                CornerRadius="12"
                BoxShadow="0 10 30 0 #1A000000"
                Padding="16"
                IsVisible="{Binding IsRosterDrawerOpen}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">

                <!-- 1. Header Sổ tay Lớp học phần -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{DynamicResource BrushPrimaryLight}"
                                    CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding ActiveRosterLhp.MaLHP}"
                                           FontFamily="Consolas, Menlo, Monospace"
                                           FontWeight="Bold" FontSize="12.5"
                                           Foreground="{DynamicResource BrushPrimaryDark}" />
                            </Border>
                            <Border Background="{DynamicResource BrushBadgeInfoBg}"
                                    BorderBrush="{DynamicResource BrushBadgeInfoBorder}"
                                    BorderThickness="1" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="{Binding ActiveRosterLhp.SiSoHienThi, StringFormat='Sĩ số: {0} SV'}"
                                           FontFamily="Consolas, Menlo, Monospace"
                                           FontWeight="Bold" FontSize="11.5"
                                           Foreground="{DynamicResource BrushBadgeInfoFg}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ActiveRosterLhp.TenMon}"
                                   FontWeight="Bold" FontSize="15.5"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ActiveRosterLhp.TenMon}" />
                        <TextBlock Text="{Binding ActiveRosterLhp.LichHocHienThi, StringFormat='Lịch học: {0}'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding DongBangDieuPhoiLopCommand}"
                            Classes="btn-icon-ghost"
                            VerticalAlignment="Top"
                            ToolTip.Tip="Đóng bảng điều phối lớp">
                        <TextBlock Text="✕" FontWeight="Bold" FontSize="14" />
                    </Button>
                </Grid>

                <!-- 2. Thống kê Cơ cấu Lớp & Công nợ -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BrushSurfaceAlt}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding RosterDemographicsText}"
                                   FontSize="11.5"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource BrushBadgeDangerBg}"
                                BorderBrush="{DynamicResource BrushBadgeDangerBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="7,2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding RosterDebtCount}">
                            <TextBlock Text="{Binding RosterDebtCount, StringFormat='{}{0} SV nợ HP'}"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushBadgeDangerFg}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Thêm nhanh 1 Sinh viên bằng Mã SV & Chuyển nhóm lớp 1-chạm -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BrushSurfaceAlt}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel Spacing="8">
                        <!-- Dòng 1: Thêm nhanh SV vào lớp -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{Binding QuickAddMaSv, Mode=TwoWay}"
                                     PlaceholderText="Nhập Mã SV để thêm nhanh vào lớp..."
                                     Height="34" CornerRadius="6"
                                     FontSize="12.5"
                                     VerticalContentAlignment="Center">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ThemNhanhSvVaoLopCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Command="{Binding ThemNhanhSvVaoLopCommand}"
                                    Classes="btn-primary"
                                    Height="34" Padding="12,0"
                                    CornerRadius="6"
                                    ToolTip.Tip="Kiểm tra trùng lịch và ghi danh tức thì vào lớp này">
                                <TextBlock Text="+ Thêm SV" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Dòng 2: Chọn Nhóm lớp đích cùng môn để Chuyển nhóm 1-chạm -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              IsVisible="{Binding HasAlternativeTransferClasses}">
                            <TextBlock Grid.Column="0"
                                       Text="Nhóm đích chuyển lớp:"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AlternativeTransferClasses}"
                                      SelectedItem="{Binding TargetTransferLhp}"
                                      HorizontalAlignment="Stretch"
                                      Height="32" CornerRadius="6"
                                      FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="dtos:LopHocPhanDisplayDto">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} ({1}) - {2}">
                                                    <Binding Path="MaLHP" />
                                                    <Binding Path="SiSoHienThi" />
                                                    <Binding Path="LichHocHienThi" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Tìm kiếm trong lớp & Nút Copy Điểm Danh -->
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Grid.Column="0"
                             Text="{Binding RosterSearchQuery, Mode=TwoWay}"
                             PlaceholderText="Lọc sinh viên trong lớp (Mã SV, Họ tên, Lớp SH)..."
                             Height="34" CornerRadius="6"
                             FontSize="12.5"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding SaoChepPhieuDiemDanhCommand}"
                            Classes="btn-secondary"
                            Height="34" Padding="10,0"
                            CornerRadius="6"
                            ToolTip.Tip="Sao chép bảng điểm danh 5 buổi chuẩn Excel vào Clipboard">
                        <TextBlock Text="📋 Copy Điểm Danh" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    </Button>
                </Grid>

                <!-- 5. Danh sách Sinh viên trong Lớp học phần -->
                <Border Grid.Row="4"
                        Background="{DynamicResource BrushBackground}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Background="{DynamicResource BrushSurfaceAlt}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="10,6">
                            <Grid ColumnDefinitions="28,76,*,62,88">
                                <TextBlock Grid.Column="0" Text="#" Classes="caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="Mã SV" Classes="caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="2" Text="Họ tên &amp; Lớp" Classes="caption" FontWeight="Bold" />
                                <TextBlock Grid.Column="3" Text="Học phí" Classes="caption" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Điều phối" Classes="caption" FontWeight="Bold" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RosterStudents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="dtos:ClassRosterStudentDto">
                                        <Border BorderBrush="{DynamicResource BrushTableDivider}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,7">
                                            <Grid ColumnDefinitions="28,76,*,62,88" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding STT}"
                                                           FontFamily="Consolas, Menlo, Monospace"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MaSV}"
                                                           FontFamily="Consolas, Menlo, Monospace"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="{DynamicResource BrushPrimaryDark}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding HoTen}"
                                                               FontWeight="SemiBold" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding HoTen}" />
                                                    <TextBlock Text="{Binding LopSinhHoat, StringFormat='Lớp: {0}'}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSecondary}" />
                                                </StackPanel>
                                                <Panel Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource BrushBadgeDangerBg}"
                                                            BorderBrush="{DynamicResource BrushBadgeDangerBorder}"
                                                            BorderThickness="1" CornerRadius="5" Padding="5,1"
                                                            IsVisible="{Binding IsConNo}"
                                                            ToolTip.Tip="{Binding TrangThaiHocPhiText}">
                                                        <TextBlock Text="Nợ HP" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushBadgeDangerFg}" />
                                                    </Border>
                                                    <Border Background="{DynamicResource BrushBadgeSuccessBg}"
                                                            BorderBrush="{DynamicResource BrushBadgeSuccessBorder}"
                                                            BorderThickness="1" CornerRadius="5" Padding="5,1"
                                                            IsVisible="{Binding !IsConNo}">
                                                        <TextBlock Text="Đủ HP" FontSize="10.5" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushBadgeSuccessFg}" />
                                                    </Border>
                                                </Panel>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <!-- Nút Chuyển sang nhóm lớp khác cùng môn 1-chạm -->
                                                    <Button Classes="row-action"
                                                            Width="26" Height="26" Padding="0"
                                                            Background="#EFF6FF" BorderBrush="#BFDBFE"
                                                            Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).ChuyenNhomLopSvCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).HasAlternativeTransferClasses}"
                                                            ToolTip.Tip="Chuyển sinh viên này sang nhóm lớp đích đã chọn ở trên">
                                                        <TextBlock Text="⇄" FontWeight="Bold" FontSize="12" Foreground="#1D4ED8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <!-- Nút Mở hồ sơ ĐKHP của SV -->
                                                    <Button Classes="row-action"
                                                            Width="26" Height="26" Padding="0"
                                                            Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).MoHoSoSvTrongDkhpCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Mở hồ sơ Đăng ký học phần của sinh viên này">
                                                        <TextBlock Text="↗" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushPrimaryDark}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <!-- Nút Rút khỏi lớp -->
                                                    <Button Classes="row-action delete"
                                                            Width="26" Height="26" Padding="0"
                                                            Command="{Binding $parent[UserControl].((vm:HocKyLopHocPhanViewModel)DataContext).RutSvKhoiLopCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Rút sinh viên khỏi lớp học phần này">
                                                        <TextBlock Text="✕" FontWeight="Bold" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 6. Chân trang Ngăn kéo: Nạp hàng loạt bằng Smart Import Studio -->
                <Button Grid.Row="5"
                        Command="{Binding NapSinhVienSmartCommand}"
                        CommandParameter="{Binding ActiveRosterLhp}"
                        Classes="btn-secondary"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="10,8">
                    <TextBlock Text="📋 Mở Smart Import Studio (Dán danh sách Excel/Zalo vào lớp này)"
                               FontWeight="SemiBold" FontSize="12" />
                </Button>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
