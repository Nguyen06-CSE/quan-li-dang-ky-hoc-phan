<!-- src/QuanLyDKHP.App/Views/SinhVienView.axaml -->

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QuanLyDKHP.App.ViewModels"
             xmlns:dtos="using:QuanLyDKHP.Core.Dtos"
             xmlns:helpers="using:QuanLyDKHP.App.Helpers"
             x:Class="QuanLyDKHP.App.Views.SinhVienView"
             x:DataType="vm:SinhVienViewModel">

    <!-- 2. KHAI BÁO RESOURCE SO SÁNH -->
    <UserControl.Resources>
        <helpers:VietnameseNameComparer x:Key="VietnameseNameComparer"/>
    </UserControl.Resources>

    <!-- Đổi RowDefinitions: Auto (Header), Auto (Toolbar), Auto (Progress), * (DataGrid cuộn vô tận) -->
    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        
        <!-- 1. Header & Count -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Sinh viên" Classes="h1" />
            <TextBlock Text="{Binding TotalItems, StringFormat='(Tổng số: {0})'}" Classes="caption" VerticalAlignment="Bottom" Margin="0,0,0,4" />
        </StackPanel>

        <!-- Status Message Banner -->
        <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" 
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding IsStatusError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </Border>

        <!-- 2. Toolbar -->
        <Grid Grid.Row="1" ColumnDefinitions="280,180,180,*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" Text="{Binding TuKhoa, Mode=TwoWay}" PlaceholderText="Tìm theo Mã SV hoặc Họ tên..." Margin="0,0,8,0" />

            <ComboBox Grid.Column="1" ItemsSource="{Binding DsLopSinhHoat}" SelectedItem="{Binding LopFilter}" HorizontalAlignment="Stretch" Margin="0,0,8,0" />

            <ComboBox Grid.Column="2" ItemsSource="{Binding DsKhoaHoc}" SelectedItem="{Binding KhoaHocFilter}" HorizontalAlignment="Stretch" Margin="0,0,8,0" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ExportExcelCommand}" Content="Xuất Excel" Classes="btn-secondary" />
                <Button Command="{Binding ImportExcelCommand}" Content="Import Excel" Classes="btn-secondary" IsVisible="{Binding CanThemSuaXoa}" />
                <Button Command="{Binding ThemCommand}" Content="+ Thêm sinh viên" Classes="btn-primary" IsVisible="{Binding CanThemSuaXoa}" />
            </StackPanel>
        </Grid>

        <!-- Thanh loading chạy vô tận khi đang lọc hoặc lấy data -->
        <ProgressBar Grid.Row="2" IsIndeterminate="True" 
                     IsVisible="{Binding IsLoading}" 
                     Height="2" Margin="0,0,0,8" 
                     HorizontalAlignment="Stretch"/>

        <!-- 3. DataGrid (Virtualization & Infinite Scrolling tự động kích hoạt khi ở trong lưới *) -->
        <DataGrid Grid.Row="3" 
                  x:Name="SinhVienDataGrid"
                  ItemsSource="{Binding DanhSach}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  GridLinesVisibility="All" 
                  BorderThickness="1" 
                  BorderBrush="{DynamicResource BrushBorder}" 
                  CornerRadius="6"
                  SelectionMode="Single"
                  DoubleTapped="OnDataGridDoubleTapped">
            
            <!-- ContextMenu cho từng row: click chuột phải để ĐKHP/Sửa/Xóa -->
            <DataGrid.Styles>
                <Style Selector="DataGridRow">
                    <Setter Property="ContextMenu">
                        <ContextMenu>
                            <MenuItem Header="Đăng ký học phần" 
                                      Command="{Binding $parent[UserControl].((vm:SinhVienViewModel)DataContext).DangKyHocPhanCommand}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Sửa" 
                                      Command="{Binding $parent[UserControl].((vm:SinhVienViewModel)DataContext).SuaCommand}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:SinhVienViewModel)DataContext).CanThemSuaXoa}" />
                            <MenuItem Header="Xóa" 
                                      Command="{Binding $parent[UserControl].((vm:SinhVienViewModel)DataContext).XoaCommand}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding $parent[UserControl].((vm:SinhVienViewModel)DataContext).CanThemSuaXoa}" />
                        </ContextMenu>
                    </Setter>
                </Style>
            </DataGrid.Styles>
            
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSV}" Width="140" />
                
                <!-- 3. GẮN THUỘC TÍNH CustomSortComparer VÀO CỘT HỌ VÀ TÊN -->
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding HoTen}" Width="*" 
                                    CustomSortComparer="{StaticResource VietnameseNameComparer}"/>
                                    
                <DataGridTextColumn Header="Lớp sinh hoạt" Binding="{Binding LopSinhHoat}" Width="160" />
                <DataGridTextColumn Header="Khóa học" Binding="{Binding KhoaHoc}" Width="140" />
                <DataGridTextColumn Header="Số TC ĐK (HK hiện tại)" Binding="{Binding SoTinChiDangKy}" Width="180" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>